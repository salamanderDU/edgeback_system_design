{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeback.local/schemas/run_metadata.schema.json",
  "title": "EdgeBack Run Metadata",
  "type": "object",
  "required": [
    "schema_version", "run_id", "status", "started_at_utc", "finished_at_utc",
    "strategy", "config_hash", "data_manifest_hash", "logical_identity_hash", "seed",
    "execution_model", "runtime", "artifact_checksums", "conclusion_label"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "research_id": {"type": ["string", "null"]},
    "trial_id": {"type": ["string", "null"]},
    "parent_run_id": {"type": ["string", "null"]},
    "fold_id": {"type": ["string", "null"]},
    "status": {"enum": ["CREATED", "RUNNING", "COMPLETED", "FAILED"]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "strategy": {
      "type": "object",
      "required": ["id", "parameters"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "parameters": {"type": "object"}
      }
    },
    "config_hash": {"type": "string"},
    "data_manifest_hash": {"type": "string"},
    "strategy_id": {"type": "string"},
    "strategy_version": {"type": ["string", "null"]},
    "strategy_params_hash": {"type": "string"},
    "engine_version": {"type": "string"},
    "seed": {"type": "integer"},
    "execution_model": {"type": "object"},
    "logical_identity_hash": {"type": "string"},
    "code": {"type": "object"},
    "runtime": {"type": "object"},
    "artifact_checksums": {"type": "object", "additionalProperties": {"type": "string"}},
    "conclusion_label": {
      "enum": [
        "ENGINE_VALIDATION_ONLY", "INSUFFICIENT_EVIDENCE", "IN_SAMPLE_ONLY", "OOS_FAILED",
        "OOS_PROMISING_NOT_ROBUST", "ROBUST_ON_TESTED_DATA"
      ]
    }
  },
  "additionalProperties": true
}
